# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Legacy anon JWT, or the newer publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: preferred over NEXT_PUBLIC_SUPABASE_ANON_KEY when set
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps (ships to the browser; restrict by HTTP referrer in Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Google Apps Script endpoint for the feedback form
NEXT_PUBLIC_FEEDBACK_SCRIPT_URL=

# Server-only. Never expose to the client, never commit real values.
GEMINI_API_KEY=
IMAGEKIT_PRIVATE_KEY=

# Local maintenance scripts only (*.cjs). Never commit, never put in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
